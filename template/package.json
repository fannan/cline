{
  "name": "my-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/shared/*"
  ],
  "scripts": {
    "dev": "run-p dev:api dev:dashboard",
    "dev:api": "npm run dev -w @my-app/api",
    "dev:dashboard": "npm run dev -w @my-app/dashboard",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
