{
  "name": "@marcellafoundation/slack",
  "version": "1.0.0",
  "description": "Slack Block Kit client for posting messages with graceful degradation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "slack",
    "block-kit",
    "notifications",
    "messaging"
  ],
  "author": "Marcella Foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcella-foundation/marcella-framework.git",
    "directory": "packages/slack"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  }
}
