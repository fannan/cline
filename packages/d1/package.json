{
  "name": "@marcella/d1",
  "version": "1.0.0",
  "description": "Auto-detecting Cloudflare D1 client that works in both Node.js (REST API) and Workers (native binding)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare",
    "d1",
    "database",
    "workers",
    "edge"
  ],
  "author": "Marcella Foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcella-foundation/marcella-framework.git",
    "directory": "packages/d1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  }
}
