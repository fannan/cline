{
  "name": "@marcella/storage",
  "version": "1.0.0",
  "description": "React hooks for persistent state using localStorage with SSR safety and cross-tab sync",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "hooks",
    "localStorage",
    "state",
    "persistence",
    "ssr"
  ],
  "author": "Marcella Foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcella-foundation/marcella-framework.git",
    "directory": "packages/storage"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  }
}
